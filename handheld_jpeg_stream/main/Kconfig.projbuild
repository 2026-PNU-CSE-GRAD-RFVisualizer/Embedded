menu "RFVisualizer handheld JPEG stream"

config HANDHELD_LOCAL_10FPS_TEST
    bool "Run embedded 10-frame / 10 FPS LCD animation test"
    default n
    help
        Show ten embedded 800x480 baseline JPEG frames at 100 ms intervals
        forever. Wi-Fi and server streaming are skipped while this is enabled.
        Disable it to use the network JPEG stream client.

config HANDHELD_LCD_PIXEL_CLOCK_MHZ
    int "LCD I80 pixel clock (MHz)"
    range 8 20
    default 16
    help
        16 MHz is intended for the cached 10 FPS test. Reduce this if long
        breadboard wiring causes pixel noise; reducing it also lowers FPS.

config HANDHELD_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
        Local device setting. Do not commit a real SSID.

config HANDHELD_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    help
        Local secret. Do not commit a real password or sdkconfig.

config JPEG_STREAM_SERVER_HOST
    string "Image relay server IPv4 address or host name"
    default ""
    help
        Local device setting. Enter the PC running image_relay; do not commit
        a site-specific address.

config JPEG_STREAM_SERVER_PORT
    int "Image relay viewer port"
    range 1 65535
    default 9102

config JPEG_STREAM_MAX_FRAME_BYTES
    int "Maximum image payload bytes"
    range 65536 2097152
    default 524288
    help
        This embedded limit is deliberately lower than the relay's 8 MiB
        protocol limit. It covers JPEG and compressed RGB332 payloads. Two
        buffers of this size are allocated in PSRAM.

config JPEG_STREAM_RX_TIMEOUT_MS
    int "TCP receive timeout (ms)"
    range 1000 30000
    default 5000

config JPEG_STREAM_RX_TASK_STACK
    int "Receiver task stack bytes"
    range 4096 16384
    default 6144

config JPEG_STREAM_SINK_TASK_STACK
    int "Frame sink task stack bytes"
    range 4096 16384
    default 16384
    help
        The RGB332 zlib path calls the ROM miniz inflater, whose decompressor
        state requires substantially more stack than the JPEG-only path.

endmenu
